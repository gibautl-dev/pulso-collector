# Exclusivamente servidor. Nunca usar prefijos públicos ni incluir en el frontend.
# Conexión PostgreSQL de Supabase; exigir TLS. Codificar caracteres de la contraseña.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.PROJECT.supabase.co:5432/postgres?sslmode=require
SUPABASE_URL=
# Opcional para una futura integración REST; psycopg usa DATABASE_URL.
SUPABASE_SERVICE_ROLE_KEY=
PULSO_TIMEZONE=America/Argentina/Buenos_Aires
PULSO_LOG_LEVEL=INFO
# Reservadas: las fuentes permanecen apagadas aunque se complete una clave.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
META_ACCESS_TOKEN=
META_IG_USER_ID=
SERPAPI_KEY=
# Clasificador IA (ver docs/classifier.md). Apagado por defecto.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_REASONING_EFFORT=none
PULSO_CLASSIFY_ENABLED=false
PULSO_CLASSIFY_DRY_RUN=true
PULSO_CLASSIFY_MAX_PER_RUN=30
PULSO_CLASSIFY_BATCH_SIZE=10
# Rol propio pulso_classifier (deploy/classifier_permissions.sql); nunca pulso_collector.
CLASSIFIER_DATABASE_URL=postgresql://pulso_classifier.PROJECT@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
CLASSIFIER_PGPASSWORD=

# Política de URLs: strict (default), allowlist (excepciones exactas), off.
# Off desactiva chequeo DNS/IP, pero mantiene HTTP(S), sin credenciales y puertos 80/443.
PULSO_URL_SECURITY_MODE=strict
PULSO_URL_ALLOWED_HOSTS=
# Usar HTTP_PROXY/HTTPS_PROXY/ALL_PROXY y NO_PROXY del entorno cuando es true.
PULSO_HTTP_TRUST_ENV=false
# Usado por el cron si no se indica --candidate.
PULSO_CANDIDATE=
